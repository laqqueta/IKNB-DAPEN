<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>id.go.ojk</groupId>
    <artifactId>OJK-BOM</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <properties>
        <version.junit>4.8.1</version.junit>
        <version.commons-io>2.4</version.commons-io>
        <version.commons-compress>1.10</version.commons-compress>
        <version.slf4j-api>1.7.21</version.slf4j-api>
        <version.logback-classic>1.1.7</version.logback-classic>
        <version.commons-lang3>3.4</version.commons-lang3>
        <version.xstream>1.4.9</version.xstream>
        <version.lombok>1.16.10</version.lombok>
        <version.guava>19.0</version.guava>
        <version.jackson-databind>2.7.4</version.jackson-databind>
        <!--<version.httpclient>4.5.2</version.httpclient>-->
        <version.httpclient>4.5.14</version.httpclient>
        <version.batik-svg-dom>1.6-1</version.batik-svg-dom>
        <version.bcprov-jdk15on>1.47</version.bcprov-jdk15on>
        <version.bcprov-ext-jdk15on>1.54</version.bcprov-ext-jdk15on>
        <version.bcpkix-jdk15on>1.47</version.bcpkix-jdk15on>
        <version.icepdf-viewer>6.1.1</version.icepdf-viewer>
        <version.icepdf-core>6.1.1</version.icepdf-core>
        <version.gson>2.8.6</version.gson>
        <version.mssql-jdbc>6.2.2.jre8</version.mssql-jdbc>
        <version.javax-wsdl>1.6.2</version.javax-wsdl>
        <version.commons-discovery>0.2</version.commons-discovery>
        <version.commons-net>3.6</version.commons-net>
        <version.jaxrpc>1.1</version.jaxrpc>
        <version.axis>1.4</version.axis>
        <!--<version.itextpdf>5.5.13.3</version.itextpdf>-->
        <version.pdfbox>3.0.4</version.pdfbox>
        <!--<version.pdfbox>2.0.33</version.pdfbox>-->
        <version.commons-cli>1.5.0</version.commons-cli>
        <version.OJK-Client>3.3.3</version.OJK-Client>
        <version.OJK-Libraries-Client>3.3.3</version.OJK-Libraries-Client>
        <version.OJK-Configuration-Client>3.3.3</version.OJK-Configuration-Client>
        <version.OJK-Metadata>1.0.1</version.OJK-Metadata>
        <version.commons-net>3.10.0</version.commons-net>
        <version.duckdb_jdbc>1.1.3</version.duckdb_jdbc>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>id.go.ojk</groupId>
                <artifactId>OJK-Libraries-Client</artifactId>
                <version>${version.OJK-Libraries-Client}</version>
            </dependency>
            <dependency>
                <groupId>id.go.ojk</groupId>
                <artifactId>OJK-Client</artifactId>
                <version>${version.OJK-Client}</version>
            </dependency>
            <dependency>
                <groupId>id.go.ojk</groupId>
                <artifactId>OJK-Configuration-Client</artifactId>
                <version>${version.OJK-Configuration-Client}</version>
            </dependency>
            <dependency>
                <groupId>id.go.ojk</groupId>
                <artifactId>OJK-Metadata</artifactId>
                <version>${version.OJK-Metadata}</version>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${version.junit}</version>
            </dependency>
            <!--<dependency>
                <groupId>com.itextpdf</groupId>
                <artifactId>itextpdf</artifactId>
                <version>${version.itextpdf}</version>
            </dependency>-->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${version.pdfbox}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>preflight</artifactId>
                <version>${version.pdfbox}</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${version.commons-io}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${version.commons-compress}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${version.slf4j-api}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${version.logback-classic}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${version.commons-lang3}</version>
            </dependency>
            <dependency>
                <groupId>com.thoughtworks.xstream</groupId>
                <artifactId>xstream</artifactId>
                <version>${version.xstream}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${version.guava}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${version.jackson-databind}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${version.httpclient}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpmime</artifactId>
                <version>${version.httpclient}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${version.lombok}</version>
                <scope>provided</scope>
            </dependency>
            <!-- ICE PDF -->
            <dependency>
                <groupId>batik</groupId>
                <artifactId>batik-svg-dom</artifactId>
                <version>${version.batik-svg-dom}</version>
                <exclusions>
                    <exclusion>
                        <artifactId>xercesImpl</artifactId>
                        <groupId>xerces</groupId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk15on</artifactId>
                <version>${version.bcprov-jdk15on}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-ext-jdk15on</artifactId>
                <version>${version.bcprov-ext-jdk15on}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk15on</artifactId>
                <version>${version.bcpkix-jdk15on}</version>
            </dependency>
            <dependency>
                <groupId>org.icepdf.os</groupId>
                <artifactId>icepdf-core</artifactId>
                <version>${version.icepdf-core}</version>
            </dependency>
            <dependency>
                <groupId>org.icepdf.os</groupId>
                <artifactId>icepdf-viewer</artifactId>
                <version>${version.icepdf-viewer}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${version.gson}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.sqlserver</groupId>
                <artifactId>mssql-jdbc</artifactId>
                <version>${version.mssql-jdbc}</version>
            </dependency>
            <dependency>
                <groupId>javax.wsdl</groupId>
                <artifactId>javax-wsdl</artifactId>
                <version>${version.javax-wsdl}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.axis</groupId>
                <artifactId>axis</artifactId>
                <version>${version.axis}</version>
            </dependency>
            <dependency>
                <groupId>javax.xml.rpc</groupId>
                <artifactId>jaxrpc</artifactId>
                <version>${version.jaxrpc}</version>
            </dependency>
            <dependency>
                <groupId>commons-discovery</groupId>
                <artifactId>commons-discovery</artifactId>
                <version>${version.commons-discovery}</version>
            </dependency>
            <dependency>
                <groupId>commons-cli</groupId>
                <artifactId>commons-cli</artifactId>
                <version>${version.commons-cli}</version>
            </dependency>
            <dependency>
                <groupId>commons-net</groupId>
                <artifactId>commons-net</artifactId>
                <version>${version.commons-net}</version>
            </dependency>
            <dependency>
                <groupId>org.duckdb</groupId>
                <artifactId>duckdb_jdbc</artifactId>
                <version>${version.duckdb_jdbc}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.10.1</version>
                    <configuration>
                        <source>1.8</source>
                        <target>1.8</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.2.0</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.2.4</version>
                </plugin>
                <plugin>
                    <groupId>com.akathist.maven.plugins.launch4j</groupId>
                    <artifactId>launch4j-maven-plugin</artifactId>
                    <version>1.7.25</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>