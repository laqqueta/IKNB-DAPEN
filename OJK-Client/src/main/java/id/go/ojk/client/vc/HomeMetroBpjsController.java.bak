package id.go.ojk.client.vc;

import java.util.List;

import id.go.ojk.lib.client.exception.SlikException;
import id.go.ojk.lib.client.model.constant.DisplayScene;
import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.image.ImageView;
import lombok.extern.slf4j.Slf4j;

@Slf4j
public abstract class HomeMetroBpjsController extends BaseHomeMetroController {
  public static final double HEIGHT_RATIO = 1.081730769230769;
  public static final double WITH_RATIO = 6.058823529411765;
  public static final double WITH_CORRECTION = 0;

  protected abstract List<Button> getCustomButtons();

  protected abstract List<ImageView> getCustomButtonImages();

  public boolean isResizeSendingImage() {
    return true;
  }

  public boolean isResizeButtonImages() {
    return true;
  }

  @Override
  protected void setSendingImageSize(ImageView sendingImage, double with) {
    if (isResizeSendingImage()) {
      setImageFitSize(sendingImage, with * HEIGHT_RATIO, WITH_RATIO, WITH_CORRECTION);
    }
  }

  @Override
  protected void initializeCustomMenu(double with) {
    if (isResizeButtonImages()) {
      if (getCustomButtonImages() != null) {
        getCustomButtonImages().forEach(i -> {
          setImageFitSize(i, with * HEIGHT_RATIO, WITH_RATIO, WITH_CORRECTION);
        });
      }
    }
  }

  @Override
  protected void disableCustomButton(boolean isDisable) {
    if (getCustomButtons() != null) {
      getCustomButtons().forEach(b -> {
        if (b != null) {
          b.setDisable(isDisable);
        }
      });
    }
  }

  @FXML
  public void handleOpenReport(ActionEvent event) {
    Button button = (Button) event.getSource();
    try {
      DisplayScene scene = DisplayScene.valueOf(button.getId());
      mainApplication.getCustomForm().getFormBpjsTk().showForm(scene);
      mainApplication.synchMenuToRealDisplay();
    } catch (Exception e) {
      log.error(e.getMessage(), e);
      throw new SlikException(e.getMessage(), e);
    }
  }
}
