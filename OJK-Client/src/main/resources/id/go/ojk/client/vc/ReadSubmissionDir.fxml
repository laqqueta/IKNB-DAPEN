<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
	minHeight="-Infinity" minWidth="-Infinity" prefHeight="431.0"
	prefWidth="602.0" styleClass="background-ojk-red"
	stylesheets="@ojk.css" xmlns="http://javafx.com/javafx/8.0.65"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="id.go.ojk.client.vc.ReadSubmissionDirController">
	<children>
		<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
			minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
			prefWidth="600.0" styleClass="background-ojk-grey"
			AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0"
			AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="30.0">
			<children>
				<ProgressBar fx:id="progressBar" layoutX="68.0"
					layoutY="18.0" prefHeight="20.0" prefWidth="521.0" progress="0.0"
					AnchorPane.leftAnchor="60.0" AnchorPane.rightAnchor="15.0" />
				<Label fx:id="progressLabel" layoutX="26.0" layoutY="20.0"
					text="0 %" AnchorPane.leftAnchor="15.0" />
				<TabPane fx:id="tabPane" layoutX="15.0" layoutY="66.0"
					prefHeight="200.0" prefWidth="200.0"
					stylesheets="@ojk-tab-black.css" tabClosingPolicy="UNAVAILABLE"
					AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="15.0"
					AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="60.0">
					<tabs>
						<Tab fx:id="processTab" text="Proses">
							<content>
								<AnchorPane minHeight="0.0" minWidth="0.0"
									prefHeight="180.0" prefWidth="200.0">
									<children>
										<TextArea fx:id="processTextArea" prefHeight="200.0"
											prefWidth="200.0" AnchorPane.bottomAnchor="0.0"
											AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
											AnchorPane.topAnchor="0.0" />
									</children>
								</AnchorPane>
							</content>
						</Tab>
						<Tab fx:id="errorTab" text="Validasi">
							<content>
								<AnchorPane minHeight="0.0" minWidth="0.0"
									prefHeight="180.0" prefWidth="200.0">
									<children>
										<TextArea fx:id="errorTextArea" prefHeight="200.0"
											prefWidth="200.0" AnchorPane.bottomAnchor="0.0"
											AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
											AnchorPane.topAnchor="0.0" />
									</children>
								</AnchorPane>
							</content>
						</Tab>
					</tabs>
				</TabPane>
				<Button fx:id="closeButton" layoutX="515.0" layoutY="350.0"
					mnemonicParsing="false" onAction="#handleClose" text="Tutup"
					AnchorPane.bottomAnchor="15.0" AnchorPane.rightAnchor="15.0" />
				<Button fx:id="stopButton" layoutX="458.0" layoutY="360.0"
					mnemonicParsing="false" onAction="#handleStop" text="Berhenti"
					AnchorPane.bottomAnchor="15.0" AnchorPane.rightAnchor="75.0" />
			</children>
		</AnchorPane>
	</children>
</AnchorPane>
