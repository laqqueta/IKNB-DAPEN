<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns="http://javafx.com/javafx/8.0.101"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="id.go.ojk.client.vc.RootLayoutController">
	<children>
		<BorderPane fx:id="rootBorderPane" minHeight="-Infinity"
			minWidth="-Infinity" prefHeight="600.0" prefWidth="920.0"
			styleClass="background-ojk-red" stylesheets="@ojk.css"
			AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
			AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
			<top>
				<AnchorPane fx:id="topAnchorPane" prefHeight="35.0"
					prefWidth="796.0">
					<BorderPane.margin>
						<Insets bottom="-3.0" />
					</BorderPane.margin>
					<children>
						<TabPane fx:id="menuTabPane" layoutY="-1.0"
							prefHeight="58.0" prefWidth="796.0"
							AnchorPane.bottomAnchor="-4.0" AnchorPane.leftAnchor="0.0"
							AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="-1.0">
							<tabs>
								<Tab fx:id="homeTab" closable="false"
									onSelectionChanged="#handleMainMenu" styleClass="tab-menu" />
								<Tab fx:id="otherTab" onSelectionChanged="#handleMainMenu"
									text="test" />
							</tabs>
						</TabPane>
						<HBox alignment="CENTER_RIGHT" prefHeight="35.0"
							prefWidth="600.0" spacing="3.0" AnchorPane.rightAnchor="0.0"
							AnchorPane.topAnchor="0.0">
							<children>
								<MenuBar />
								<ImageView fitHeight="23.0" fitWidth="23.0"
									pickOnBounds="true" preserveRatio="true">
									<image>
										<Image url="@images/connect96x96.png" />
									</image>
								</ImageView>
								<Label fx:id="connectionStatusLabel"
									style="-fx-text-fill: #FFFFFF;">
									<padding>
										<Insets right="10.0" />
									</padding>
								</Label>
								<ImageView fitHeight="23.0" fitWidth="23.0"
									pickOnBounds="true" preserveRatio="true">
									<image>
										<Image url="@images/user96x96-White.png" />
									</image>
								</ImageView>
								<Label fx:id="userLoginLabel"
									style="-fx-text-fill: #FFFFFF;" text="Dany Ardianto Kurniawan" />
								<MenuBar id="tooltipmenu-1"
									nodeOrientation="RIGHT_TO_LEFT" prefHeight="25.0"
									prefWidth="0.0">
									<menus>
										<Menu id="tooltipmenu-2" mnemonicParsing="false">
											<items>
												<MenuItem fx:id="aboutMenuItem"
													mnemonicParsing="false" onAction="#handleAbout"
													text="Tentang" />
												<MenuItem fx:id="changePasswordMenuItem"
													mnemonicParsing="false" onAction="#handleChangePassword"
													text="Ubah Password" />
												<MenuItem mnemonicParsing="false"
													onAction="#handleLogout" text="Logout" />
											</items>
										</Menu>
									</menus>
									<opaqueInsets>
										<Insets />
									</opaqueInsets>
								</MenuBar>
							</children>
						</HBox>
					</children>
				</AnchorPane>
			</top>
			<padding>
				<Insets bottom="2.0" left="2.0" right="2.0" top="30.0" />
			</padding>
		</BorderPane>
		<HBox fx:id="busyPane" alignment="CENTER" layoutX="238.0"
			layoutY="-3.219379425048828" prefHeight="260.0" prefWidth="325.0"
			AnchorPane.bottomAnchor="120.0" AnchorPane.leftAnchor="238.0"
			AnchorPane.rightAnchor="237.0" AnchorPane.topAnchor="120.0">
			<children>
				<ProgressIndicator fx:id="busyProgressIndicator"
					prefHeight="50.0" prefWidth="130.0" style="-fx-accent: #ffa602;" />
			</children>
		</HBox>
	</children>
</AnchorPane>
