<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="1024.0"
	styleClass="background-ojk-grey" stylesheets="@ojk.css"
	xmlns="http://javafx.com/javafx/8.0.65"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="id.go.ojk.client.vc.UserOfflineManagementController">
	<center>
		<VBox BorderPane.alignment="CENTER">
			<BorderPane.margin>
				<Insets left="15.0" right="15.0" />
			</BorderPane.margin>
			<children>
				<HBox alignment="CENTER_LEFT" spacing="5.0">
					<VBox.margin>
						<Insets top="10.0" />
					</VBox.margin>
					<children>
						<Button fx:id="addButton" contentDisplay="CENTER"
							mnemonicParsing="false" onAction="#handleAddUser" text="Tambah" />
						<Button fx:id="editButton" alignment="CENTER"
							layoutX="10.0" layoutY="10.0" mnemonicParsing="false"
							onAction="#handleEditUser" text="Ubah" />
						<Button fx:id="deleteButton" alignment="CENTER"
							layoutX="77.0" layoutY="10.0" mnemonicParsing="false"
							onAction="#handleDeleteUser" text="Hapus" />
						<Pane HBox.hgrow="ALWAYS" />
						<ImageView fitHeight="39.0" fitWidth="103.0">
							<image>
								<Image url="@images/Logo-OJK.png" />
							</image>
						</ImageView>
					</children>
				</HBox>
				<TableView id="userTable" fx:id="userTable"
					prefHeight="298.0" prefWidth="770.0" scaleShape="false">
					<columns>
						<TableColumn id="numberColumn" fx:id="numberColumn"
							prefWidth="50.0" text="No" />
						<TableColumn id="userLoginIdColumn"
							fx:id="userLoginIdColumn" prefWidth="158.0" text="User ID" />
						<TableColumn id="userNameColumn"
							fx:id="userNameColumn" prefWidth="317.0" text="Nama" />
						<TableColumn id="roleColumn" fx:id="roleDescColumn"
							prefWidth="317.0" text="Jenis  User" />
					</columns>
					<VBox.margin>
						<Insets top="20.0" />
					</VBox.margin>
				</TableView>
			</children>
		</VBox>
	</center>
</BorderPane>
