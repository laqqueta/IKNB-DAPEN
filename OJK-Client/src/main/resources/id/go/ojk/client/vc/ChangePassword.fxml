<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
	minHeight="-Infinity" minWidth="-Infinity" prefHeight="361"
	prefWidth="410.0" styleClass="background-ojk-red"
	stylesheets="@ojk.css" xmlns="http://javafx.com/javafx/8.0.101"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="id.go.ojk.client.vc.ChangePasswordController">
	<children>
		<VBox layoutX="1.0" layoutY="32.0" prefWidth="398.0"
			spacing="5.0" styleClass="background-ojk-grey"
			AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0"
			AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="32.0">
			<children>
				<Label styleClass="label-red" text="Password Lama" />
				<PasswordField fx:id="oldPasswordField"
					promptText="Password lama" />
				<Label layoutX="20.0" layoutY="20.0" styleClass="label-red"
					text="Password Baru">
					<VBox.margin>
						<Insets top="10.0" />
					</VBox.margin>
				</Label>
				<PasswordField fx:id="newPasswordField" layoutX="20.0"
					layoutY="37.0" promptText="Password baru" />
				<PasswordField fx:id="reNewPasswordField"
					layoutX="20.0" layoutY="96.0" promptText="Konfirmasi password baru" />
				<HBox>
					<Label text="- " prefWidth="10.0"/>
					<Label fx:id="labelRule" prefWidth="380.0"
					text="Password terdiri dari huruf besar, huruf kecil, angka dan karakter khusus"
					textAlignment="JUSTIFY" textFill="#bfbebe" wrapText="true"/>
				</HBox>
				<HBox>
					<Label text="- " prefWidth="10.0"/>
					<Label fx:id="labelRule" prefWidth="380.0" 
					text="Panjang minimal 8 karakter"
					textAlignment="JUSTIFY" textFill="#bfbebe" wrapText="true"/>
				</HBox>
				<Label fx:id="labelMessage" textAlignment="JUSTIFY" wrapText="true"/>
				<HBox alignment="CENTER_RIGHT" prefHeight="51.0"
					prefWidth="400.0" spacing="10.0">
					<children>
						<CheckBox visible="false" fx:id="checkBoxResetPassword" onAction="#handleCheckBoxResetPassword" text="Reset Password"/>
						<Button fx:id="buttonClose" cancelButton="true" mnemonicParsing="false"
							onAction="#closeDialog" text="Batal" />
						<Button defaultButton="true" mnemonicParsing="false"
							onAction="#handleChangePassword" text="Ubah" />
					</children>
				</HBox>
			</children>
			<padding>
				<Insets left="10.0" right="10.0" top="10.0" />
			</padding>
		</VBox>
		<ProgressIndicator fx:id="busyIndicator"
			style="-fx-accent: #ffa602;" visible="false"
			AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="100.0"
			AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="120.0" />
	</children>
</AnchorPane>
